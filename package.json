{
  "name": "typist",
  "productName": "Typist",
  "version": "0.1.0",
  "private": true,
  "description": "离线五笔练习工具",
  "author": "Typist",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.main.json && vite build",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "smoke": "npm run build && electron tests/smoke.cjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.1",
    "electron": "44.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.1.1"
  }
}
